{
  "name": "dosya-help",
  "main": "./worker/index.mjs",
  "compatibility_date": "2026-10-09",
  "workers_dev": false,
  "observability": { "enabled": true },
  "assets": {
    "binding": "ASSETS", "directory": "./dist", "run_worker_first": true,
    "html_handling": "drop-trailing-slash", "not_found_handling": "404-page"
  },
  // Social share images, uploaded by `npm run og` (scripts/og-images.mjs), served at /og/...
  "r2_buckets": [{ "binding": "OG", "bucket_name": "dosya-help-og" }],
  // Workers Custom Domain: Cloudflare creates and owns the help.dosya.dev DNS
  // record and certificate. Nothing else on the zone claims this hostname
  // (the marketing Worker is routed on dosya.dev/* only).
  "routes": [{ "pattern": "help.dosya.dev", "custom_domain": true }]
}
